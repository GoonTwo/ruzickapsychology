{
  "name": "ruzickapsychology",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prepare": "husky",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "css-types": "node -e \"require('node:fs').rmSync('.generated/css-types', { recursive: true, force: true })\" && tcm src --pattern \"**/*.module.css\" --allowArbitraryExtensions --outDir .generated/css-types && prettier --write \".generated/css-types/**/*.module.d.css.ts\"",
    "check:generated": "npm run check:generated-clean",
    "check:generated-clean": "node scripts/check-generated-clean.mjs",
    "components:validate": "node scripts/validate-component-structure.mjs",
    "privacy:check": "node scripts/check-provider-disclosures.mjs",
    "typegen": "sanity schema extract --enforce-required-fields && sanity typegen generate",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "playwright:install": "playwright install --with-deps chromium",
    "verify:quick": "npm run components:validate && npm run lint && npm run typecheck && npm run test",
    "verify": "npm run css-types && npm run typegen && npm run check:generated-clean && npm run components:validate && npm run privacy:check && npm run format:check && npm run lint && npm run typecheck && npm run sanity:validate-content && npm run test && npm run build",
    "verify:ci": "npm run verify && npm run playwright:install && npm run test:e2e",
    "verify:release": "npm run verify:ci && npm run lhci",
    "lhci": "lhci autorun",
    "analyze": "next experimental-analyze --output",
    "sanity:seed": "sanity exec scripts/seed-sanity.ts --with-user-token",
    "sanity:migrate-seo-pages": "sanity exec scripts/migrate-seo-service-pages.ts --with-user-token",
    "sanity:validate-content": "sanity exec scripts/validate-sanity-content.ts",
    "sanity:repair-keys": "sanity exec scripts/repair-sanity-array-keys.ts --with-user-token"
  },
  "dependencies": {
    "@portabletext/react": "^6.2.0",
    "@sanity/icons": "^3.7.4",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^5.31.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "^16.2.10",
    "next-sanity": "^13.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sanity": "^5.31.1",
    "schema-dts": "^2.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@portabletext/markdown": "^1.4.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "playwright": "^1.61.1",
    "prettier": "^3.9.3",
    "sharp": "^0.35.2",
    "svgo": "^4.0.1",
    "typed-css-modules": "^0.9.1",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,css,md,mdx,yml,yaml}": "prettier --write --ignore-unknown --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "eslint --fix --no-warn-ignored --no-error-on-unmatched-pattern",
    "src/**/*.module.css": "bash -c 'npm run css-types'"
  }
}
